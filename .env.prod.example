# ClauseFlow — Production environment variables
# Copy this to .env.prod and fill every value before deploying.
# The deploy.sh script auto-generates the secret values for you.

# ── Domain ────────────────────────────────────────────────────────────────────
# Your app hostname (no https://, no trailing slash). DocuSeal is served at
# sign.${DOMAIN}; for example, DOMAIN=app.yourdomain.com creates
# https://sign.app.yourdomain.com.
DOMAIN=app.yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Strong random password — deploy.sh generates this automatically
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_POOL_SIZE=20        # Postgres connection pool size per process (app + worker each)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Storage (MinIO) ──────────────────────────────────────────────────────────
MINIO_ROOT_USER=clauseflow
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Auth ──────────────────────────────────────────────────────────────────────
# 32+ random bytes — deploy.sh generates this automatically
BETTER_AUTH_SECRET=REPLACE_WITH_SECRET

# ── Notification encryption (required for Slack/Teams webhooks) ───────────────
# 32+ random bytes — deploy.sh generates this automatically
NOTIFICATION_ENCRYPTION_KEY=REPLACE_WITH_SECRET

# ── Email (optional SMTP; Resend example) ─────────────────────────────────────
# Leave SMTP_HOST empty to run without email. For Resend, use:
# SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=resend
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_KEY
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
ALERT_EMAIL_TO=your@email.com

# ── DocuSeal (e-signatures) ──────────────────────────────────────────────────
# Reviewed immutable DocuSeal image digest. Replace only with a separately
# reviewed digest.
DOCUSEAL_IMAGE=docuseal/docuseal@sha256:063f9b89fa99816d0c2f90c33e4e176ecbbdf8cddd4958e40562643d0431dfbc
# deploy.sh generates DOCUSEAL_SECRET_KEY_BASE automatically
DOCUSEAL_SECRET_KEY_BASE=REPLACE_WITH_SECRET
# After first deploy, log into sign.app.yourdomain.com → API → copy the key here,
# then restart: docker compose -f docker-compose.prod.yml restart app worker
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=

# ── AI (optional — leave empty, users bring their own keys) ──────────────────
# You can set global keys here if you want to offer managed AI,
# or leave empty and let each user configure their own in Settings.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── CRM Integrations (optional — required only if enabling CRM features) ──────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# ── Google Drive Import (optional — required only if enabling Google Drive import)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Observability ─────────────────────────────────────────────────────────────
# No OpenTelemetry collector is bundled with production Compose. Leave tracing
# disabled unless the endpoint is reachable from both the app and worker
# containers. Their distinct default service names are clauseflow-app and
# clauseflow-worker, so do not set OTEL_SERVICE_NAME unless a shared name is
# deliberate.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
