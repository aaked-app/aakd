enable-pre-post-scripts=true
# Self-hosted installs may run on slower or rate-limited networks. Keep
# dependency installation deterministic while allowing transient registry
# resets to recover without requiring a manual rebuild.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=120000
network-concurrency=8
