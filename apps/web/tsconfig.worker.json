{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "noEmit": false,
    "outDir": ".worker-dist",
    "paths": {
      "bullmq": ["./node_modules/bullmq"],
      "@prisma/client": ["./node_modules/@prisma/client"],
      "@/*": ["./*"]
    }
  },
  "include": ["worker.ts", "lib/**/*.ts", "prisma/**/*.ts", "types/**/*.ts"],
  "exclude": ["node_modules", "tmp", ".next", ".next-*", "tests"]
}
