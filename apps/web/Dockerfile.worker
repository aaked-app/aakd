# syntax=docker/dockerfile:1.7
FROM node@sha256:50c8e8ca1d27439048670df5883f32d57cf81cff6233222c893fd0d9884cbd81 AS deps
RUN --mount=type=cache,id=aakd-npm,target=/root/.npm npm install -g pnpm@10.33.3
WORKDIR /app
# Copy manifests first — cached until a manifest changes
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/.npmrc ./.npmrc
COPY apps/web/package.json ./apps/web/
RUN --mount=type=cache,id=aakd-pnpm-store,target=/root/.local/share/pnpm/store \
  pnpm install --frozen-lockfile \
  && pnpm --filter web deploy --prod --legacy /prod

FROM node@sha256:50c8e8ca1d27439048670df5883f32d57cf81cff6233222c893fd0d9884cbd81 AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 workerjs && adduser --system --uid 1001 --ingroup workerjs workerjs
# LibreOffice is used by the document.convert worker to convert PDF→DOCX before
# parsing with mammoth. DejaVu provides deterministic French and Arabic glyph
# fallback when source documents request fonts such as Arial.
RUN for attempt in 1 2 3 4 5; do \
    apk add --no-cache libreoffice poppler-utils font-dejavu && exit 0; \
    echo "apk dependency install failed (attempt ${attempt}/5), retrying"; \
    sleep $((attempt * 5)); \
  done; \
  exit 1
# Prisma CLI is needed only while building the generated worker client; keeping
# it global avoids shipping the full development dependency tree.
RUN --mount=type=cache,id=aakd-npm,target=/root/.npm \
  npm install -g prisma@7.9.1 \
  --fetch-retries=5 \
  --fetch-retry-factor=2 \
  --fetch-retry-mintimeout=10000 \
  --fetch-retry-maxtimeout=120000 \
  --fetch-timeout=120000

# Use a portable production-only dependency tree instead of copying the entire
# workspace store and development dependencies into the worker image.
COPY --chown=workerjs:workerjs --from=deps /prod/node_modules ./apps/web/node_modules
# Worker job modules live at /app/worker and resolve packages from the app
# workspace through this shared runtime dependency path.
RUN ln -s /app/apps/web/node_modules /app/node_modules

# Copy worker source into apps/web/ so module resolution matches local dev
COPY --chown=workerjs:workerjs apps/web/prisma ./apps/web/prisma
COPY --chown=workerjs:workerjs apps/web/worker.ts ./apps/web/
COPY --chown=workerjs:workerjs apps/web/lib ./apps/web/lib
COPY --chown=workerjs:workerjs apps/web/eng.traineddata ./apps/web/eng.traineddata
RUN echo "5dc5d8d640a212c9d6184921ba103b186f50e0fed9ee716c53e6b312b400d747  ./apps/web/eng.traineddata" | sha256sum -c -
COPY THIRD_PARTY_NOTICES.md ./THIRD_PARTY_NOTICES.md
COPY third-party-licenses ./third-party-licenses
COPY --chown=workerjs:workerjs apps/web/scripts/reindex-contract.ts ./apps/web/scripts/reindex-contract.ts
COPY --chown=workerjs:workerjs apps/web/tsconfig.json ./apps/web/
COPY --chown=workerjs:workerjs apps/web/tsconfig.worker.json ./apps/web/
COPY --chown=workerjs:workerjs apps/web/.npmrc ./apps/web/
COPY --chown=workerjs:workerjs worker/ ./worker/

# Switch to the web package directory so relative paths + binaries align
WORKDIR /app/apps/web
RUN prisma generate --schema=./prisma/schema.prisma

USER workerjs
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD node -e "process.kill(1, 0)"
CMD ["node_modules/.bin/tsx", "--tsconfig", "tsconfig.worker.json", "worker.ts"]
